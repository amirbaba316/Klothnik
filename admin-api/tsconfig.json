{
    "extends": "../tsconfig.json", // inherits settings from the root tsconfig
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "rootDir": "./",
        "outDir": "./build" // compiled JS will go into client-api/dist
    },
    "include": ["src/**/*", "app.ts"], // only compile files in src/
    "exclude": ["node_modules", "build"], // ignore node_modules & build output
    "references": [{ "path": "../shared" }]
}
